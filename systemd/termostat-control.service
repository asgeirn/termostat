[Unit]
Description=Termostat: PI temperature controller (shadow mode, writes nothing)
Documentation=file://@SRC@/README.md

[Service]
Type=oneshot
EnvironmentFile=@ENV_FILE@
Environment=PYTHONPATH=@SRC@/src
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@PYTHON@ -m termostat.control
TimeoutStartSec=1min
Nice=10
NoNewPrivileges=yes
