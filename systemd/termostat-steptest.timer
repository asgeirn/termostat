[Unit]
Description=Termostat: step test runner every 5 minutes

[Timer]
# One minute after the logger, so the decision just after midnight sees a fresh reading.
# Runs all day; outside the night window and with no test active it only reads the database.
# The test window itself (00:00–05:30) is evaluated in local time by the program.
OnCalendar=*-*-* *:1/5:00 UTC
AccuracySec=10s

[Install]
WantedBy=timers.target
